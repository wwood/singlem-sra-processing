## ncbi-vdb configuration for the weebill workflow image.
##
## Some SRA runs are reference-compressed (cSRA): runs submitted as aligned
## CRAM/BAM store READ bases as differences against a reference genome. To
## reconstruct the reads, ncbi-vdb (linked statically by sracat-rs) must fetch
## the REFSEQ objects for that reference from NCBI. Without a remote repository
## and a writable cache to download them into, reading such a run dies on the
## first row with "row 1: reading READ failed", sracat-rs emits nothing, and
## weebill then reports "No reads were sketched". Plain (non-reference-compressed)
## runs never touch this path, so most runs worked and only the cSRA ones failed.
##
## This config enables the remote repository and points the user cache at a
## POD-LOCAL directory (/root/ncbi/public on the pod's ephemeral disk). It is
## deliberately NOT shared between pods: each pod downloads the references it
## needs into its own ephemeral storage, which is discarded when the pod ends.
## The IMAGE_GUID line is appended at image-build time (see the Dockerfile).

/libs/cloud/report_instance_identity = "true"

# Remote name resolver + repository. Enabled by default in ncbi-vdb; set
# explicitly so reference resolution cannot be silently turned off.
/repository/remote/disabled = "false"
/repository/remote/main/SDL.2/resolver-cgi = "https://locate.ncbi.nlm.nih.gov/sdl/2/retrieve"

# Pod-local user cache. Fetched references land under this root on the pod's
# ephemeral disk; cache-enabled must be true or downloaded refseqs are not kept
# for the duration of the read.
/repository/user/cache-enabled = "true"
/repository/user/main/public/root = "/root/ncbi/public"
/repository/user/main/public/apps/refseq/volumes/refseq = "refseq"
/repository/user/main/public/apps/sra/volumes/sraFlat = "sra"
/repository/user/main/public/apps/wgs/volumes/wgsFlat = "wgs"
/repository/user/main/public/apps/file/volumes/flat = "files"

# Accession-as-directory reads: a bare .sra file in the working directory (how
# this workflow reads every run) keeps resolving to the current directory.
/repository/user/ad/public/root = "."
/repository/user/ad/public/apps/refseq/volumes/refseqAd = "."
/repository/user/ad/public/apps/sra/volumes/sraAd = "."
/repository/user/ad/public/apps/wgs/volumes/wgsAd = "."
/repository/user/ad/public/apps/file/volumes/flatAd = "."
